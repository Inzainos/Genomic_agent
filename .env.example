# ==============================================================================
# SNT Genomic Topologic Analyzer — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ── LLM (Required for AI-powered diagnosis) ────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Which model to use via OpenRouter (default works without changing)
LLM_MODEL=anthropic/claude-3.5-sonnet

# ── Telegram (Optional — enables real push notifications) ──────────────────
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat_id by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Analysis Tuning (Optional) ─────────────────────────────────────────────
# Z-Score threshold for anomaly detection (default: 2.5)
# Lower = more sensitive, higher = more specific
SNT_Z_THRESHOLD=2.5
