# ==============================================================================
# SNT Genomic Topologic Analyzer — .gitignore
# ==============================================================================

# Environment & secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/

# SQLite databases (generated at runtime)
*.db
*.sqlite
*.sqlite3

# Data volumes / pipeline output
/data/
analysis/results/*.json
tcga_data/
*.csv.gz
*.tsv.gz

# Docker
.docker/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb
